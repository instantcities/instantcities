---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for ref in site.data.lang.en.urls %}{% assign key = ref[0] %}{% for l in site.data.home.langs %}
  <url><loc>{{ site.url }}{{ site.data.lang[l].urls[key] }}</loc></url>
{%- endfor %}{% endfor %}
  <url><loc>{{ site.url }}/art/</loc></url>
{%- for a in site.data.art.pieces %}
  <url><loc>{{ site.url }}/art/{{ a.id }}/</loc></url>
{%- endfor %}
{%- for c in site.data.cities %}{% unless c.soon %}
{%- for l in site.data.home.langs %}{% assign slug = site.data.lang[l].cities[c.id].slug | default: c.id %}
  <url><loc>{{ site.url }}/{{ l }}/{{ slug }}/</loc></url>
{%- endfor %}
  <url><loc>{{ site.url }}/{{ c.id }}/play/</loc></url>
{%- if site.data.about[c.id] %}
  <url><loc>{{ site.url }}/{{ c.id }}/about-the-city/</loc></url>
  <url><loc>{{ site.url }}/{{ c.id }}/places-and-landmarks/</loc></url>
{%- endif %}
{%- for l in site.data.landmarks[c.id] %}
  <url><loc>{{ site.url }}/{{ c.id }}/landmark/{{ l.id }}/</loc></url>
{%- endfor %}
{%- endunless %}{% endfor %}
</urlset>
