---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/cities/</loc></url>
  <url><loc>{{ site.url }}/about/</loc></url>
  <url><loc>{{ site.url }}/privacy/</loc></url>
  <url><loc>{{ site.url }}/terms/</loc></url>
{%- for c in site.data.cities %}{% unless c.soon %}
  <url><loc>{{ site.url }}/{{ c.id }}/</loc></url>
  <url><loc>{{ site.url }}/{{ c.id }}/play/</loc></url>
{%- if site.data.about[c.id] %}
  <url><loc>{{ site.url }}/{{ c.id }}/about-the-city/</loc></url>
  <url><loc>{{ site.url }}/{{ c.id }}/places-and-landmarks/</loc></url>
{%- endif %}
{%- for l in site.data.landmarks[c.id] %}
  <url><loc>{{ site.url }}/{{ c.id }}/landmark/{{ l.id }}/</loc></url>
{%- endfor %}
{%- endunless %}{% endfor %}
</urlset>
